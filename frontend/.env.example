# ---------------------------------------------------------------------------
# Trends Bird dashboard — environment template
# Copy to `.env.local` and fill in.
# ---------------------------------------------------------------------------

# Where the browser sends API calls, including the /api/v1 prefix.
#
# Local development — point straight at the running API:
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
#
# Production (Vercel) — use a relative path so the calls go to this origin and
# are proxied on to BACKEND_ORIGIN below. That keeps the auth cookies
# first-party, which is what makes the session work in Safari and in
# incognito windows:
#   NEXT_PUBLIC_API_URL=/api/v1

# Origin of the deployed API: no trailing slash, no /api/v1 suffix.
# Read at build time by next.config.ts to set up the proxy rewrite.
# Leave unset locally — the rewrite is then skipped entirely.
#   BACKEND_ORIGIN=https://your-api.vercel.app
