# ---------------------------------------------------------------------------
# Trends Bird Admin API — environment template
# Copy to `.env` and fill in. Every key listed here is read by
# src/app/config/env.ts, which validates on import and crashes at boot on a
# missing key — never silently at request time.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Frontend origin allowed by CORS. Must be exact — credentials mode forbids "*".
FRONTEND_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trends_bird_admin?schema=public

# --- JWT -------------------------------------------------------------------
# Use long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_EXPIRES=7d

# --- Passwords -------------------------------------------------------------
BCRYPT_SALT_ROUND=12

# --- Seeded accounts (see README) ------------------------------------------
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@trendsbird.test
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Deliberately limited account used to verify 403 behaviour: catalog access
# only, no permission/role/user access.
CATALOG_USER_NAME=Catalog Manager
CATALOG_USER_EMAIL=catalog@trendsbird.test
CATALOG_USER_PASSWORD=Catalog@123

# --- Cloudinary (Media module) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=trends-bird/media

# --- Uploads ---------------------------------------------------------------
MAX_FILE_SIZE_MB=10

# --- Login throttling ------------------------------------------------------
# Only FAILED login attempts count toward the limit, so signing in repeatedly
# is never throttled. Raise MAX_FAILURES while exploring the API if you expect
# to trigger many deliberate 401s.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_FAILURES=20
